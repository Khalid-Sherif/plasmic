# --- Build stage ---
FROM node:24-alpine AS builder
WORKDIR /plasmic

RUN apk add --no-cache \
    bash \
    git \
    curl \
    wget \
    python3 \
    py3-pip \
    postgresql-client \
    build-base \
    make \
    jq

# Enable pnpm via corepack (bundled with Node)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy dependency/workspace manifests first for caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install root deps (installs the whole workspace based on pnpm-workspace.yaml)
RUN pnpm install --frozen-lockfile

# Copy rest of the app
COPY . .

# Create a fake git repo so rsbuild.config.ts can run git rev-parse HEAD
RUN git init && git config --global user.email "build@plasmic.app" && git config --global user.name "Build" && git add -A && git commit -m "build" --allow-empty

ARG PUBLIC_URL
ENV PUBLIC_URL=${PUBLIC_URL}
ARG REACT_APP_DEFAULT_HOST_URL
ENV REACT_APP_DEFAULT_HOST_URL=${REACT_APP_DEFAULT_HOST_URL}

ENV NODE_OPTIONS=--max_old_space_size=2048
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PUPPETEER_SKIP_DOWNLOAD=1

RUN echo "PUBLIC_URL is: $PUBLIC_URL" && \
    PUBLIC_URL=${PUBLIC_URL} pnpm run setup:sub && \
    pnpm run setup:react-web-bundle && \
    mkdir -p /plasmic/platform/wab/node_modules/.bin && \
    ln -sf /plasmic/node_modules/.bin/pegjs /plasmic/platform/wab/node_modules/.bin/pegjs && \
    ln -sf /plasmic/node_modules/.bin/pegjs-coffee-plugin /plasmic/platform/wab/node_modules/.bin/pegjs-coffee-plugin && \
    PUBLIC_URL=${PUBLIC_URL} pnpm run make

RUN cd /plasmic/platform/wab && pnpm add -D raw-loader
RUN cd /plasmic/platform/wab && pnpm add -D @rsbuild/plugin-node-polyfill

# --- Final stage ---
FROM node:24-alpine AS runtime

RUN addgroup -S plasmic && \
    adduser -S plasmic -G plasmic && \
    apk add --no-cache git jq bash postgresql-client make

# Enable pnpm in runtime stage too (needed for `pnpm run` at container start)
RUN corepack enable && corepack prepare pnpm@latest --activate

USER plasmic
WORKDIR /plasmic

COPY --chown=plasmic:plasmic --from=builder /plasmic /plasmic

EXPOSE 3003 3004 3005

CMD ["sh", "-c", "\
    mkdir -p /home/plasmic/.plasmic && \
    echo '{\"encryptionKey\":\"'\"$ENCRYPTION_KEY\"'\",\"smtpAuth\":{\"user\":\"\",\"pass\":\"\"}}' > /home/plasmic/.plasmic/secrets.json && \
    cd /plasmic/platform/wab && \
    jq '(.host = \"plasmic-db\") | (.password = \"'\"$DB_PASSWORD\"'\") | (.username = \"'\"$DB_USER\"'\") | (.database = \"'\"$DB_NAME\"'\")' ormconfig.json > tmp.json && mv tmp.json ormconfig.json && \
    echo \"DATABASE_URI=postgres://$DB_USER:$DB_PASSWORD@plasmic-db:5432/$DB_NAME\" > .env && \
    echo \"WAB_DBNAME=$DB_NAME\" >> .env && \
    echo \"WAB_DBPASSWORD=$DB_PASSWORD\" >> .env && \
    echo \"NODE_ENV=development\" >> .env && \
    echo \"PUBLIC_URL=$PUBLIC_URL\" >> .env && \
    pnpm run typeorm migration:run && \
    pnpm run seed && \
    cd /plasmic && \
    PUBLIC_URL=$PUBLIC_URL pnpm run dev \
"]
