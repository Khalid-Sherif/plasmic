# --- Build stage ---
FROM node:24-alpine AS builder
WORKDIR /plasmic

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apk add --no-cache \
    bash \
    git \
    curl \
    wget \
    python3 \
    py3-pip \
    postgresql-client \
    build-base \
    make \
    jq

# Enable yarn via corepack (explicitly using 1.22.22 to avoid Yarn 4 Berry plugin issues)
RUN corepack enable && corepack prepare yarn@1.22.22 --activate && corepack prepare pnpm@11.8.0 --activate

# Bypass Corepack strict mode so it ignores the "packageManager": "pnpm" field in package.json
ENV COREPACK_ENABLE_STRICT=0

# Copy dependency files first for caching
COPY package.json yarn.lock pnpm-workspace.yaml ./

# Install root deps (installs the whole workspace and correctly links root binaries)
# Using --prefer-offline and high timeout to prevent network drops
RUN yarn install --prefer-offline --network-timeout 600000

# Copy rest of the app
COPY . .

# Create a fake git repo so rsbuild.config.ts can run git rev-parse HEAD
RUN git init && git config --global user.email "build@plasmic.app" && git config --global user.name "Build" && git add -A && git commit -m "build" --allow-empty

ARG PUBLIC_URL
ENV PUBLIC_URL=${PUBLIC_URL}
ARG REACT_APP_DEFAULT_HOST_URL
ENV REACT_APP_DEFAULT_HOST_URL=${REACT_APP_DEFAULT_HOST_URL}

# Run setup steps individually to control memory usage
ENV NODE_OPTIONS="--max-old-space-size=2048 --dns-result-order=ipv4first"
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PUPPETEER_SKIP_DOWNLOAD=1

# Use the package.json scripts.
# Because we updated them in Step 1, they now use 'yarn' with --prefer-offline,
# single-threaded network concurrency, and built-in 10-minute network timeouts.
RUN echo "PUBLIC_URL is: $PUBLIC_URL" && \
    PUBLIC_URL=${PUBLIC_URL} yarn setup:sub && \
    yarn setup:react-web-bundle && \
    yarn setup:live-frame && \
    yarn setup:loader-bundle-env && \
    yarn setup:loader-html-hydrate && \
    yarn setup:wab && \
    yarn setup:canvas-packages && \
    PUBLIC_URL=${PUBLIC_URL} yarn make

RUN cd /plasmic/platform/wab && yarn add raw-loader --dev
RUN cd /plasmic/platform/wab && yarn add @rsbuild/plugin-node-polyfill --dev
RUN find /plasmic -path '*node_modules/@plasmicapp/react-web*' -name '*.js' -exec sed -i 's|https://img.plasmic.app|https://plasmic.atheta.net|g' {} \;

# --- Final stage ---
FROM node:24-alpine AS runtime

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN addgroup -S plasmic && \
    adduser -S plasmic -G plasmic && \
    apk add --no-cache git jq bash postgresql-client make

# Enable yarn in runtime stage too
RUN corepack enable && corepack prepare yarn@1.22.22 --activate
ENV COREPACK_ENABLE_STRICT=0

USER plasmic
WORKDIR /plasmic

COPY --chown=plasmic:plasmic --from=builder /plasmic /plasmic

EXPOSE 3003 3004 3005

CMD ["sh", "-c", "\
    mkdir -p /home/plasmic/.plasmic && \
    echo '{\"encryptionKey\":\"'\"$ENCRYPTION_KEY\"'\",\"smtpAuth\":{\"user\":\"\",\"pass\":\"\"}}' > /home/plasmic/.plasmic/secrets.json && \
    cd /plasmic/platform/wab && \
    jq '(.host = \"plasmic-db\") | (.password = \"'\"$DB_PASSWORD\"'\") | (.username = \"'\"$DB_USER\"'\") | (.database = \"'\"$DB_NAME\"'\")' ormconfig.json > tmp.json && mv tmp.json ormconfig.json && \
    echo \"DATABASE_URI=postgres://$DB_USER:$DB_PASSWORD@plasmic-db:5432/$DB_NAME\" > .env && \
    echo \"WAB_DBNAME=$DB_NAME\" >> .env && \
    echo \"WAB_DBPASSWORD=$DB_PASSWORD\" >> .env && \
    echo \"NODE_ENV=production\" >> .env && \
    echo \"PUBLIC_URL=$PUBLIC_URL\" >> .env && \
    yarn typeorm migration:run && \
    export NODE_ENV=production && \
    cd /plasmic/platform/wab && \
    export NODE_ENV=production && \
    export REACT_APP_DEV_PROXY=$PUBLIC_URL && \
    export STATIC_URL=$STATIC_URL && \
    export POSTHOG_HOST=$POSTHOG_HOST && \
    export POSTHOG_REVERSE_PROXY_HOST=$POSTHOG_REVERSE_PROXY_HOST && \
    export POSTHOG_API_KEY=$POSTHOG_API_KEY && \
    export SENTRY_DSN=$SENTRY_DSN && \
    export SENTRY_ORG_ID=$SENTRY_ORG_ID && \
    export SENTRY_PROJECT_ID=$SENTRY_PROJECT_ID && \
    export STRIPE_PUBLISHABLE_KEY=$STRIPE_PUBLISHABLE_KEY && \
    pnpm build-css && \
    PUBLIC_URL=$PUBLIC_URL bash tools/dev-server.bash build && \
    ( BUILD_DIR=$(pwd)/build node tools/serve-prod.js & ) ; \
    bash tools/host-server.bash & \
    bash tools/backend-server.bash \
"]
